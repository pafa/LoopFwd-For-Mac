        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LoopFwd 观察器"
          }
        }
      }
    },
    "LoopFwd only sends text when it can address the exact session. Other terminal and editor hosts remain Jump-only until they expose a proven control API.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有能精确定位会话时，LoopFwd 才发送文本。其他终端和编辑器在具备经验证的控制 API 前，仅支持返回。"
          }
        }
      }
